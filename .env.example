# Copy this file to ".env" (same folder) and fill in your values. ".env" is never committed.

# Where the password-reset links should point (the frontend address)
FRONTEND_URL=http://localhost:8080

# Email used to send password-reset links. Leave EMAIL_HOST empty to save emails
# as files in sent_emails/ instead of sending them (handy for local testing).
#
# Gmail:  EMAIL_HOST=smtp.gmail.com, EMAIL_HOST_USER=you@gmail.com,
#         EMAIL_HOST_PASSWORD=<16-character app password, not your normal password>
# Brevo:  EMAIL_HOST=smtp-relay.brevo.com, EMAIL_HOST_USER/PASSWORD from Brevo > SMTP & API
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=CareerPath Analyzer <you@example.com>

# Live jobs (RapidAPI > JSearch > X-RapidAPI-Key)
JSEARCH_API_KEY=
