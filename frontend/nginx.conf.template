# Serves the built React app and forwards API traffic to Django.
# ${BACKEND_URL} is filled in from the environment when the container starts.

# keep "https" when a load balancer in front of us (e.g. Azure) already ended the TLS connection
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 80;
    root /usr/share/nginx/html;
    client_max_body_size 3m;  # profile photos are limited to 2 MB

    location ~ ^/(api|media|admin|static)/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;  # Azure's ingress rejects nginx's default HTTP/1.0 with "426 Upgrade Required"
        proxy_set_header Connection "";
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-Host  $http_host;  # includes the port, e.g. localhost:8081
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_read_timeout 60s;
    }

    # Security headers for files nginx serves itself; Django already sends its own on /api etc.
    # (nginx drops server-level add_header in any location that has its own, so they are repeated here.)

    # built JS/CSS have content hashes in their names, so they can be cached for a long time
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options nosniff always;
    }

    # every other path is a page of the React app
    location / {
        try_files $uri /index.html;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }
}
